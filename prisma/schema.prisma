generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/nuvora-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique(map: "Product_slug_key")
  description String      @db.Text
  category    String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String?     @db.LongText
  isActive    Boolean     @default(true)
  sellerId    String?
  seller      Seller?     @relation(fields: [sellerId], references: [id], map: "Product_sellerId_fkey")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@map("product")
}

model Seller {
  id           String    @id @default(cuid())
  email        String    @unique(map: "Seller_email_key")
  name         String
  shopName     String
  phone        String?
  profilePhoto String?   @db.LongText
  firebaseUid  String?   @unique
  passwordHash String?
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("seller")
}

model Customer {
  id           String     @id @default(cuid())
  email        String     @unique(map: "Customer_email_key")
  name         String?
  phone        String?
  address      String?    @db.Text
  profilePhoto String?    @db.LongText
  firebaseUid  String?   @unique
  passwordHash String?
  createdAt    DateTime   @default(now())
  orders       Order[]
  cartItems    CartItem[]

  @@map("customer")
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique(map: "AuthSession_token_key")
  userType  UserType
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("authsession")
}

model CartItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([productId, updatedAt])
  @@map("cartitem")
}

enum UserType {
  CUSTOMER
  SELLER
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction, map: "Order_customerId_fkey")
  items      OrderItem[]
  createdAt  DateTime    @default(now())

  @@map("order")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, map: "OrderItem_orderId_fkey")
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, map: "OrderItem_productId_fkey")

  @@map("orderitem")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
